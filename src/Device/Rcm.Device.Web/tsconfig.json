{
  "compilerOptions": {
    "noImplicitAny": true,
    "noEmitOnError": true,
    "removeComments": false,
    "sourceMap": true,
    "target": "es2020",
    "diagnostics": true,
    "module": "es2020",
    "rootDir": "wwwroot/js",
    "paths": { "*": [ "./wwwroot/lib/*" ] }
  },
  "include": [ "wwwroot/js/**/*.ts" ]
}
